<Project>

	<!--
		Settings shared by every project in the repository (src/ and tests/).

		UseArtifactsOutput moves all build output out of the project folders and into a single
		artifacts/ directory next to this file:

			artifacts/bin/<Project>/<configuration>_<tfm>/   compiled assemblies
			artifacts/obj/<Project>/                         intermediate files
			artifacts/package/<configuration>/               NuGet packages (*.nupkg)

		The release workflow pushes packages from artifacts/package/release.
	-->
	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
	</PropertyGroup>

	<!--
		One C# version for every target framework. Without this each framework compiles with its own
		default (net10.0 as C# 14, net11.0 as C# 15), so shared source could only use the older one.
		Language features that need runtime support on net10.0 (union types, closed hierarchies) are
		not part of the public API - see docs/Platform/index.md.
	-->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

</Project>
