<Project>

	<!--
		Settings shared by every project in the repository (src/ and tests/). Libraries add their own in
		src/Directory.Build.props, tests in tests/Directory.Build.props. Package versions live in
		Directory.Packages.props.

		UseArtifactsOutput moves all build output out of the project folders and into a single
		artifacts/ directory next to this file:

			artifacts/bin/<Project>/<configuration>_<tfm>/   compiled assemblies
			artifacts/obj/<Project>/                         intermediate files
			artifacts/package/<configuration>/               NuGet packages (*.nupkg)

		The release workflow pushes packages from artifacts/package/release.
	-->
	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<!--
			Set explicitly: by default the SDK puts artifacts/ next to the nearest Directory.Build.props,
			which for the libraries is src/Directory.Build.props. Everything must land in one root folder.
		-->
		<ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
	</PropertyGroup>

	<!--
		Every library and every test project targets the same frameworks, with one C# version. Without
		LangVersion each framework would compile with its own default (net10.0 as C# 14, net11.0 as C# 15),
		so shared source could only use the older one. Language features that need runtime support on
		net10.0 (union types) are not part of the public API - see docs/Platform/index.md.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Stamps the build time into the informational version of every assembly. -->
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
	</PropertyGroup>

</Project>
