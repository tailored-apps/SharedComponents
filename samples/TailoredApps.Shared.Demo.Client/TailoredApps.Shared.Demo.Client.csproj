<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<!--
		The browser client of the sample service: Blazor WebAssembly with MudBlazor, no JavaScript of its own.
		It references the DataModel project and nothing else of the service, so the messages it sends and the
		responses it reads are the very types the Web API uses - there is no generated client to keep in step.
		The Web API serves it (one origin, no CORS).

		One target framework, on purpose. The browser runs on the Mono runtime, which in .NET 11 does not
		execute runtime-async methods, and the net11.0 assets of this repository are compiled that way
		(eng/RuntimeAsync.targets). On net10.0 every reference resolves to the classic assets.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RootNamespace>TailoredApps.Demo.Client</RootNamespace>
		<!-- No gzip copies during a build, here and in the host that serves these files: see the WebApi project. -->
		<DisableBuildCompression>true</DisableBuildCompression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="MudBlazor" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TailoredApps.Shared.Demo.DataModel\TailoredApps.Shared.Demo.DataModel.csproj" />
	</ItemGroup>

</Project>
