{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Demo": {
    "UseFakeGateways": true,
    "Office365Inbox": false
  },
  "WebApiDefaults": {
    "ServiceName": "tailoredapps-demo",
    "HttpClient": {
      "EnableServiceDiscovery": false
    }
  },
  "Mail": {
    "Providers": {
      "Smtp": {
        "Host": "localhost",
        "Port": 25,
        "From": "shop@demo.example",
        "IsProd": false,
        "CatchAll": "developers@demo.example"
      }
    }
  },
  "Payments": {
    "Providers": {
      "Adyen": {
        "ApiKey": "demo-not-a-real-key",
        "MerchantAccount": "DemoShop",
        "NotificationHmacKey": "00112233445566778899AABBCCDDEEFF00112233445566778899AABBCCDDEEFF",
        "ReturnUrl": "https://localhost/payment/return",
        "CheckoutUrl": "https://gateway.demo/adyen/v71"
      },
      "Cashbill": {
        "ServiceUrl": "https://gateway.demo/cashbill/",
        "ShopId": "demo-shop",
        "ShopSecretPhrase": "demo-not-a-real-secret",
        "ReturnUrl": "https://localhost/payment/return",
        "NegativeReturnUrl": "https://localhost/payment/failed"
      },
      "HotPay": {
        "SecretHash": "demo-not-a-real-secret",
        "ServiceUrl": "https://gateway.demo/hotpay",
        "ReturnUrl": "https://localhost/payment/return"
      },
      "PayNow": {
        "ApiKey": "demo-not-a-real-key",
        "SignatureKey": "demo-not-a-real-secret",
        "ServiceUrl": "https://gateway.demo/paynow",
        "ReturnUrl": "https://localhost/payment/return",
        "ContinueUrl": "https://localhost/payment/return"
      },
      "PayU": {
        "ClientId": "demo-client",
        "ClientSecret": "demo-not-a-real-secret",
        "PosId": "demo-pos",
        "SignatureKey": "demo-not-a-real-secret",
        "ServiceUrl": "https://gateway.demo/payu",
        "NotifyUrl": "https://localhost/api/webhooks/PayU",
        "ContinueUrl": "https://localhost/payment/return"
      },
      "Przelewy24": {
        "MerchantId": 100001,
        "PosId": 100001,
        "ApiKey": "demo-not-a-real-key",
        "CrcKey": "demo-not-a-real-secret",
        "ServiceUrl": "https://gateway.demo/p24",
        "ReturnUrl": "https://localhost/payment/return",
        "NotifyUrl": "https://localhost/api/webhooks/Przelewy24"
      },
      "Revolut": {
        "ApiKey": "demo-not-a-real-key",
        "WebhookSecret": "demo-not-a-real-secret",
        "ApiUrl": "https://gateway.demo/revolut"
      },
      "Stripe": {
        "SecretKey": "demo-not-a-real-key",
        "WebhookSecret": "demo-not-a-real-secret",
        "SuccessUrl": "https://localhost/payment/return",
        "CancelUrl": "https://localhost/payment/failed"
      },
      "Tpay": {
        "ClientId": "demo-client",
        "ClientSecret": "demo-not-a-real-secret",
        "SecurityCode": "demo-not-a-real-secret",
        "ServiceUrl": "https://gateway.demo/tpay",
        "ReturnUrl": "https://localhost/payment/return",
        "NotifyUrl": "https://localhost/api/webhooks/Tpay"
      }
    }
  }
}
