<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Domain\Exception\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.ML" Version="5.0.1" />
		<PackageReference Include="Microsoft.ML" Version="5.0.1" />
		<PackageReference Include="Microsoft.ML.ImageAnalytics" Version="5.0.1" />
		<PackageReference Include="Microsoft.ML.Vision" Version="5.0.1" />
		<PackageReference Include="Microsoft.ML.AutoML" Version="0.23.1" />
		<PackageReference Include="FluentValidation" Version="12.*" />
		<!-- Pin transitive dependency to address NU1903 vulnerability in 9.0.4 (GHSA-73j8-2gch-69rq) -->
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TailoredApps.Shared.MediatR\TailoredApps.Shared.MediatR.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />

		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>
</Project>
