<Project>

  <!--
    Runtime async (.NET 11+)

    Compiles the async methods of every library under src/ as runtime-async for the target frameworks that
    support it (net11.0 and newer). The runtime then suspends and resumes the method itself instead of the
    C# compiler generating a state machine type per async method: lower overhead and smaller IL. Nothing
    changes in the source code or in the public API.

    Why a .targets file: the switch is decided per target framework, and $(TargetFramework) is only
    reliably known once the project body has been evaluated.

    Why it is conditioned: with the .NET 11 SDK the flag fails the net10.0 build (SYSLIB5007 / CA2252 - the
    runtime helpers are still experimental there) and is silently ignored on older frameworks. Only the
    net11.0+ assets get it; the net8.0 / net9.0 / net10.0 assets keep compiler-generated state machines.

    Opt out: runtime async needs CoreCLR or NativeAOT. Mono-based runtimes (e.g. Blazor WebAssembly) cannot
    execute it on .NET 11. Set <UseRuntimeAsync>false</UseRuntimeAsync> in a library's csproj to keep that
    library on state machines for every target framework, or pass -p:UseRuntimeAsync=false to switch it off
    for a whole build.
  -->
  <PropertyGroup Condition="'$(UseRuntimeAsync)' != 'false' and '$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!--
    Public API guard

    The 2.x line must stay compatible with 2.0.0. With -p:ValidatePublicApi=true every library is compared,
    while it is packed, with the baseline version of the same package on nuget.org; a breaking change in
    the public API fails the build (CP0001, CP0002, ...). Adding API is allowed. The "Build & Test PR"
    workflow builds with the switch on; locally:

        dotnet build TailoredApps.Shared.slnx -c Release -p:ValidatePublicApi=true

    The baseline package is downloaded during restore, so the switch has to be passed to restore as well
    when the two are run separately.

    Why a .targets file: a library can override the baseline in its own csproj, which is evaluated before
    this file. A library that did not exist in the baseline sets the first version it was published in:

        <PublicApiBaselineVersion>2.1.0</PublicApiBaselineVersion>

    and, until it has been published at all, <SkipPublicApiValidation>true</SkipPublicApiValidation>.

    Raise the default below only when a new major version becomes the compatibility baseline.
  -->
  <PropertyGroup>
    <PublicApiBaselineVersion Condition="'$(PublicApiBaselineVersion)' == ''">2.0.0</PublicApiBaselineVersion>
  </PropertyGroup>

  <!--
    3.0 replaces MediatR with ForkForward.Mediator. Request, handler and pipeline types in the public API of
    the mediator libraries move to another namespace and assembly, which is a breaking change made on
    purpose, so those libraries are left out of the comparison with 2.0.0. The other libraries are still
    compared: 3.0 may break them too, but only deliberately. A deliberate removal is recorded member by member
    in the library's CompatibilitySuppressions.xml (generated with -p:ApiCompatGenerateSuppressionFile=true
    and reviewed before it is committed), so that the rest of its API stays guarded. 3.0 removed the obsolete
    members of DateTime, ExceptionHandling, Payments.Provider.PayNow and Payments.Provider.Tpay that way.
    Once 3.0.0 is published, remove this group and those files and raise PublicApiBaselineVersion to 3.0.0.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('TailoredApps.Shared.MediatR'))">
    <SkipPublicApiValidation>true</SkipPublicApiValidation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ValidatePublicApi)' == 'true' and '$(SkipPublicApiValidation)' != 'true' and '$(IsPackable)' != 'false'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(PublicApiBaselineVersion)</PackageValidationBaselineVersion>
    <!--
      CP0003 compares assembly versions. Only a release build has one (the tag); everywhere else the
      libraries are built as 1.0.0, which would fail against any baseline without saying anything about the API.
    -->
    <NoWarn>$(NoWarn);CP0003</NoWarn>
  </PropertyGroup>

</Project>
