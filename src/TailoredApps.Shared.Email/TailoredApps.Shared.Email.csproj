<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>

		<Authors>Lukasz Kowalski</Authors>
		<Company>Tailored Apps.</Company>
		<Product>Shared.Email</Product>
		<Description>Shared.Email is a simple abstraction for Email for .NET</Description>
		<Copyright>Copyright © Lukasz Kowalski</Copyright>
		<Summary>Shared.Email is a simple abstraction for Email for .NET</Summary>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Title>Shared.Email</Title>
		<PackageId>TailoredApps.Shared.Email</PackageId>
		<PackageTags>Mediator support for .NET</PackageTags>
		<PackageProjectUrl>https://shared.tailoredapps.pl</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.*" Condition="'$(TargetFramework)' == 'net11.0'" />

		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\TailoredApps.Shared.Email.Models\TailoredApps.Shared.Email.Models.csproj" />
	</ItemGroup>
</Project>
