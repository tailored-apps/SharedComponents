<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <AssemblyName>TailoredApps.Shared.ExceptionHandling</AssemblyName>
      <RootNamespace>TailoredApps.Shared.ExceptionHandling</RootNamespace>

      <!-- Safe for trimming and NativeAOT: the analyzers are on and their warnings are errors; tests/TailoredApps.Shared.AotSmoke.Web proves it natively. -->
      <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="FluentValidation" />
    </ItemGroup>
</Project>
