<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>TailoredApps.Shared.Email.Office365</AssemblyName>
		<RootNamespace>TailoredApps.Shared.Email.Office365</RootNamespace>
		
		<Product>Shared.Email</Product>
		<Description>Shared.Email.Office365 is a simple Office365 for Email for .NET</Description>
		<Summary>Shared.Email.Office365 is a simple Office365 for Email for .NET</Summary>
		<Title>Shared.Email</Title>
		<PackageId>TailoredApps.Shared.Email.Office365</PackageId>
		<PackageTags>Mediator support for .NET</PackageTags>

		<!--
			AuthenticationConfig.Certificate is a Microsoft.Identity.Web CertificateDescription. The generated
			configuration binder cannot bind it (SYSLIB1100/SYSLIB1101) and would leave it unset, which silently
			turns certificate sign-in off. This library keeps the reflection binder; it is not a trimming or
			NativeAOT target (Microsoft.Identity.Web, MailKit).
		-->
		<EnableConfigurationBindingGenerator>false</EnableConfigurationBindingGenerator>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="MailKit" />
	  <PackageReference Include="MimeKit" />
	  <PackageReference Include="Microsoft.Identity.Web" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="TailoredApps.Shared.Email.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TailoredApps.Shared.Email\TailoredApps.Shared.Email.csproj" />
	</ItemGroup>

</Project>
