<Project>

	<!-- MSBuild only imports the nearest Directory.Build.props, so pull in the repository-wide one first. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<!--
		Settings for the published libraries only (the test projects under tests/ are not affected).

		Nullable reference types are on for every library, and nullable warnings fail the build so that
		the annotations in the public API cannot silently drift from what the code does.
	-->
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
	</PropertyGroup>

	<!--
		Trimming and NativeAOT. Options are bound from configuration by generated code instead of reflection
		(ConfigurationBinder.Get<T>() and Bind() are intercepted at compile time), so the binding survives
		trimming and needs no dynamic code. It only affects projects that call the binder.
	-->
	<PropertyGroup>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
	</PropertyGroup>

	<!--
		Packaging. Every library is a NuGet package built together with the project, with XML docs.
		The metadata below is the same for all of them; a project file only adds what is its own
		(PackageId, Title, Description, PackageTags).
	-->
	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<Authors>Lukasz Kowalski</Authors>
		<Company>Tailored Apps.</Company>
		<Copyright>Copyright © Lukasz Kowalski</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PackageProjectUrl>https://shared.tailoredapps.pl</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- iconUrl is deprecated by NuGet (NU5048) but still shown by nuget.org; there is no icon file to pack yet. -->
		<PackageIconUrl>https://www.nuget.org/profiles/TailoredApps/avatar?imageSize=512</PackageIconUrl>
		<NoWarn>$(NoWarn);NU5048</NoWarn>
	</PropertyGroup>

	<!--
		Package README. A README.md next to a project file is packed and becomes the page nuget.org shows
		for the package; nothing has to be added to the csproj. Every library has one - see
		DOCUMENTATION_RULE.md.
	-->
	<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
		<None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

</Project>
