<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Not a unit-test project: a console application that is published with NativeAOT and then run. It uses
		the libraries that declare themselves AOT-compatible the way an application does - container, options
		from configuration, a payment at every HTTP gateway, signatures, the mediator with its behaviors - and
		exits with a non-zero code when a check fails. The analyzers only see the code of one library; the AOT compiler sees the whole
		dependency closure, and running the result shows what trimming removed.

			dotnet publish tests/TailoredApps.Shared.AotSmoke -c Release -f net11.0 -r linux-x64
			./artifacts/publish/TailoredApps.Shared.AotSmoke/release_net11.0_linux-x64/TailoredApps.Shared.AotSmoke

		The "NativeAOT smoke test" job of the PR workflow does this for net10.0 and net11.0. Publishing needs a
		native toolchain: clang and zlib on Linux, the C++ build tools on Windows (-r win-x64).

		A library reference is added here when the library sets IsAotCompatible. The response cache of the
		MediatR libraries is the exception: it is checked by TailoredApps.Shared.AotSmoke.Caching, because
		HybridCache still reports trim warnings and this project allows none.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>TailoredApps.AotSmoke</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- Every trim and AOT warning of the application and of its dependencies, one by one, as an error. -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\TailoredApps.Shared.DateTime\TailoredApps.Shared.DateTime.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Querying\TailoredApps.Shared.Querying.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Email.Models\TailoredApps.Shared.Email.Models.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Email\TailoredApps.Shared.Email.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR\TailoredApps.Shared.MediatR.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR.Caching\TailoredApps.Shared.MediatR.Caching.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR.Email\TailoredApps.Shared.MediatR.Email.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR.PagedRequest\TailoredApps.Shared.MediatR.PagedRequest.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Payments\TailoredApps.Shared.Payments.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Payments.Provider.Adyen\TailoredApps.Shared.Payments.Provider.Adyen.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Payments.Provider.CashBill\TailoredApps.Shared.Payments.Provider.CashBill.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Payments.Provider.HotPay\TailoredApps.Shared.Payments.Provider.HotPay.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.Payments.Provider.PayNow\TailoredApps.Shared.Payments.Provider.PayNow.csproj" />
