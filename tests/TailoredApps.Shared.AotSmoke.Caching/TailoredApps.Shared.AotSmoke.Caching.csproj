<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The third NativeAOT smoke application: the response cache of the MediatR libraries.

		It is separate because of its one dependency that is not clean yet. Microsoft.Extensions.Caching.Hybrid
		still contains a JSON fallback that serializes by reflection (DefaultJsonSerializerFactory), and the AOT
		compiler reports it - trim and AOT warnings inside that assembly, whether the fallback is used or not.
		It is not used here: cached responses are serialized with generated metadata
		(PipelineRegistration.AddCacheSerialization), and the checks prove the cache works in the native binary.

		So this project, unlike the other two, lets the trim and AOT warning codes through as warnings. The PR
		workflow publishes it and then fails if any of those warnings names another assembly than
		Microsoft.Extensions.Caching.Hybrid - see .github/workflows/ci-pr.yml.

			dotnet publish tests/TailoredApps.Shared.AotSmoke.Caching -c Release -f net11.0 -r linux-x64
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>TailoredApps.AotSmoke.Caching</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2070;IL3050</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR\TailoredApps.Shared.MediatR.csproj" />
		<ProjectReference Include="..\..\src\TailoredApps.Shared.MediatR.Caching\TailoredApps.Shared.MediatR.Caching.csproj" />
	</ItemGroup>

</Project>
