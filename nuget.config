<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!--
		Packages come from nuget.org only, whatever extra sources a machine has configured. Central
		package management expects a single, known source (otherwise NuGet warns with NU1507).
	-->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>

</configuration>
